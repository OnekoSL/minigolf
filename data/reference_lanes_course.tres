[gd_resource type="Resource" script_class="CourseDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/course_definition.gd" id="1_course"]

[resource]
script = ExtResource("1_course")
course_id = &"reference_lanes_course"
display_name = "REFERENZBAHNEN"
